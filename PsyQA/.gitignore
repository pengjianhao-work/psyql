# 本地密钥（与根 .gitignore 互补）
.env
.env.local
*.log

# 依赖与构建
node_modules/
dist/
client/build/
client/node_modules/.cache/

# 运行时数据
chroma_data/
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/school_stats_cache.json
# 视频采集的待审核清单（本地生成，不入库）
server/data/pending_videos*.json
# 视频向量索引（由 npm run videos:embed 生成，体积大且可重建）
server/data/video_embeddings.json
