NODE_ENV=production
PORT=3001

# 必填：至少 16 字符，勿使用示例值
AUTH_SECRET=replace-with-a-long-random-secret

# 前端域名，逗号分隔（启用 credentials 时必填）
CORS_ORIGIN=https://psyqa.example.edu.cn

# Ollama（Docker Compose 内服务名 ollama）
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=qwen:7b
OLLAMA_TIMEOUT_MS=120000

# 生产勿开启快速模式
# PSYQA_FAST_ANSWER=1

PSYQA_SERVE_CLIENT=1
TRUST_PROXY=1
PSYQA_ENABLE_METRICS=0

DASHBOARD_CACHE_TTL_MS=30000
CATEGORIES_CACHE_TTL_MS=300000

# Chroma 向量库（可选，大规模 RAG 推荐）
# PSYQA_CHROMA_ENABLED=1
# CHROMA_URL=http://chroma:8000
# CHROMA_COLLECTION=psyqa_knowledge
# OLLAMA_EMBED_MODEL=nomic-embed-text
