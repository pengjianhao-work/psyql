{
  "name": "xinli-gangwan",
  "version": "1.0.0",
  "description": "心理港湾 - 温暖的心灵栖息地",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "cd client && npm run build",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "free:ports": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-dev-ports.ps1",
    "dev:server": "nodemon --watch server/src --ignore server/user_history.json --exec ts-node server/src/server.ts",
    "dev:client": "cd client && npm start",
    "test": "npm run test:server",
    "test:server": "jest --config server/jest.config.js",
    "build:embeddings": "ts-node server/scripts/build-embeddings.ts",
    "build:embeddings:all": "ts-node server/scripts/build-embeddings.ts --all",
    "embed:incremental": "ts-node server/scripts/build-embeddings.ts",
    "vector:resync": "ts-node server/scripts/resync-vector-sqlite.ts",
    "embed:full": "npm run vector:resync && npm run build:embeddings:all && npm run sync:chroma:stored",
    "expand:knowledge:full": "python ../scripts/expand_knowledge_base.py --max-knowledge 800 --max-vector 25000 --psyqa-limit 22341",
    "sync:chroma": "ts-node server/scripts/sync-chroma.ts",
    "sync:chroma:stored": "ts-node server/scripts/sync-chroma.ts --stored-only",
    "sync:chroma:reset": "ts-node server/scripts/sync-chroma.ts --reset --stored-only",
    "start:chroma": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-chroma-if-needed.ps1",
    "chat:save_emb": "ts-node server/scripts/chat-save-emb.ts",
    "user:feature_summary": "ts-node server/scripts/user-feature-summary.ts",
    "user:annual_report": "ts-node server/scripts/user-annual-report.ts",
    "install:all": "npm install && cd client && npm install",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1 -Fast",
    "setup:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1 -Start",
    "desktop-shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcuts.ps1",
    "tag:knowledge": "ts-node server/scripts/tag-mental-dataset.ts",
    "expand:knowledge": "python ../scripts/expand_knowledge_base.py",
    "expand:knowledge:download": "python ../scripts/expand_knowledge_base.py --download",
    "rebuild:vector": "python ../scripts/build_vector_db.py",
    "reload:knowledge": "ts-node server/scripts/reload-knowledge.ts",
    "pipeline:data": "python ../scripts/process_data_pipeline.py --mode full",
    "pipeline:data:rag": "python ../scripts/process_data_pipeline.py --mode rag --download",
    "pipeline:data:training": "python ../scripts/process_data_pipeline.py --mode training",
    "update:knowledge:monthly": "python ../scripts/monthly_knowledge_update.py",
    "update:knowledge:force": "python ../scripts/monthly_knowledge_update.py --force",
    "register:monthly-task": "powershell -ExecutionPolicy Bypass -File ../scripts/register_monthly_task.ps1",
    "fetch:training-data": "python ../scripts/fetch_training_datasets.py --tier domestic --soft-fail",
    "fetch:training-data:offline": "python ../scripts/fetch_training_datasets.py --offline",
    "fetch:training-data:online": "python ../scripts/fetch_training_datasets.py --tier premium",
    "fetch:training-data:extended": "python ../scripts/fetch_training_datasets.py --tier extended --soft-fail",
    "fetch:training-data:premium": "python ../scripts/fetch_training_datasets.py --tier premium",
    "fetch:training-data:all": "python ../scripts/fetch_training_datasets.py --all",
    "process:qiaoban": "python ../scripts/process_qiaoban_data.py",
    "build:training-corpus": "python ../scripts/build_training_corpus.py",
    "train:psych-weights": "python ../scripts/train_psych_weights.py",
    "train:psych-weights:incremental": "python ../scripts/train_psych_weights.py --incremental",
    "chroma:dedupe": "python ../scripts/chroma_dedupe.py",
    "eval:counsel": "python ../scripts/eval_counsel.py",
    "export:lora-dataset": "python ../scripts/export_lora_dataset.py",
    "train:lora": "python ../scripts/train_lora.py",
    "pipeline:lora": "python ../scripts/export_lora_dataset.py && python ../scripts/train_lora.py",
    "import:lora-ollama": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/import_lora_to_ollama.ps1",
    "pipeline:training": "python ../scripts/fetch_training_datasets.py --tier domestic --soft-fail && python ../scripts/build_training_corpus.py && python ../scripts/train_psych_weights.py",
    "pipeline:training:offline": "python ../scripts/fetch_training_datasets.py --offline && python ../scripts/build_training_corpus.py && python ../scripts/train_psych_weights.py"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "better-sqlite3": "^12.10.0",
    "chromadb": "^1.10.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
