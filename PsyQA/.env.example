# 心理港湾 · 本地开发环境配置（复制为 .env 后使用）
PORT=3001
NODE_ENV=development
# 开发环境密钥（生产请改为 ≥16 位随机字符串）
AUTH_SECRET=psyqa-dev-secret-change-me-local-only

# 游客模式（user1/user2/user3 免登录体验；生产演示可设为 1，正式部署建议 0）
# 非 production 环境默认允许游客；生产需显式 PSYQA_ALLOW_GUEST=1
# PSYQA_ALLOW_GUEST=1

# 并发问答上限（默认 4；压测可设为 8）
# PSYQA_MAX_ASK_REQUESTS=4

# 登录/注册限流（15 分钟内最多 20 次）
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20

# ---------- 大模型（免费方案任选其一）----------
# A. 百度千帆（ERNIE-Speed/Lite 长期免费 + 新用户 100 万 tokens）
#    QIANFAN_API_KEY=bce-v3/ALTAK-完整Key
#    QIANFAN_API_URL=https://qianfan.baidubce.com/v2
#    QIANFAN_MODEL=ernie-speed-8k
# B. 智谱官方：https://open.bigmodel.cn/usercenter/apikeys
#    ZHIPU_API_KEY=your.zhipu.key
#    ZHIPU_MODEL=glm-4-flash
# C. Ollama 本地：PSYQA_LLM_PROVIDER=ollama
PSYQA_LLM_PROVIDER=auto
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# 智谱官方免费模型（切回智谱时填写）
# ZHIPU_API_KEY=your.zhipu.key
# ZHIPU_MODEL=glm-4-flash
# 可选 glm-4.7-flash；官方默认接口，一般无需设置 ZHIPU_API_URL
# ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4

# DMXAPI 聚合（https://www.dmxapi.cn/keys，需充值）
# ZHIPU_API_KEY=sk-your-dmxapi-token
# ZHIPU_API_URL=https://www.dmxapi.cn/v1
# ZHIPU_MODEL=glm-4-flash

# 仅「快捷模式」安装会写入 PSYQA_FAST_ANSWER=1（规则+知识库，不调用大模型）
# PSYQA_FAST_ANSWER=1
# PSYQA_SKIP_OLLAMA=1

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

VECTOR_DB_PATH=./vector_db/documents.json
LOG_LEVEL=info

# Chroma 向量库（需 chroma run 或 Docker；见 docs/05_Chroma向量库.md）
PSYQA_CHROMA_ENABLED=1
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=psyqa_knowledge

# ReAct 推理链（Thought → Action → Observation，默认开启）
PSYQA_REACT_ENABLED=1
# 答辩演示完整多步 ReAct（禁用预检索短路）：PSYQA_REACT_DEMO=1
# 关闭 ReAct：PSYQA_REACT_ENABLED=0 或与 PSYQA_FAST_ANSWER=1 联用

# Agent 模式：auto | react | planner | tot | loop（核心任务闭环：思考→行动→观察→反思）
PSYQA_AGENT_MODE=loop
# 高危/多知识命中时 auto 走 planner；强制 planner：PSYQA_AGENT_AUTO_PLANNER=1
# PSYQA_AGENT_PLANNER=1 启用 LLM 规划步（默认规则规划）
# ToT：PSYQA_TOT_BRANCHES=3 分支数；PSYQA_TOT_LLM_EVAL=1 用 LLM 评分（默认规则评分更快）
# 核心任务闭环：PSYQA_LOOP_ROUNDS=2 最大轮次；PSYQA_LOOP_LLM_THOUGHT=1 思考步用 LLM
# Self-Ask 验证：ToT/Loop 默认开启；PSYQA_SELF_ASK_VERIFY=1 强制开启 / =0 关闭
# PSYQA_SELF_ASK_LLM=1 用 LLM 做自问自答核查（默认规则核查更快）

# LLM 熔断与去重
# PSYQA_LLM_DEDUPE=1 合并 500ms 内相同 prompt 请求

# 嵌入模型（推荐 bge-m3，需 Ollama 拉取）
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_MODEL=bge-m3

# LoRA 微调本地模型（QLoRA 训练后导入 Ollama）
# PSYQA_LLM_PROVIDER=ollama
# PSYQA_SKIP_OLLAMA=0
# PSYQA_PREFER_LORA=1
# PSYQA_LORA_MODEL=psyqa-counsel
# OLLAMA_MODEL=psyqa-counsel
# 训练: npm run pipeline:lora  →  导入: npm run import:lora-ollama
