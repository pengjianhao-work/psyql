CREATE TABLE mental_health_videos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(200) NOT NULL COMMENT '视频标题',
    author VARCHAR(100) COMMENT '抖音作者昵称',
    video_url VARCHAR(500) NOT NULL COMMENT '抖音分享链接',
    cover_url VARCHAR(500) COMMENT '封面图URL（可自存或代理）',
    tags VARCHAR(300) COMMENT '逗号分隔的情绪关键词，如 焦虑,抑郁,压力',
    source VARCHAR(50) DEFAULT 'douyin' COMMENT '平台',
    is_active TINYINT(1) DEFAULT 1 COMMENT '是否启用',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
